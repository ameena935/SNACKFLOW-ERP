{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "../node_modules/.bin/ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "../node_modules/.bin/vitest run",
    "test:watch": "../node_modules/.bin/vitest",
    "test:coverage": "../node_modules/.bin/vitest run --coverage",
    "prisma:generate": "../node_modules/.bin/prisma generate",
    "prisma:migrate": "../node_modules/.bin/prisma migrate dev",
    "prisma:seed": "../node_modules/.bin/ts-node --transpile-only prisma/seed.ts",
    "prisma:reset": "../node_modules/.bin/prisma migrate reset --force",
    "prisma:studio": "../node_modules/.bin/prisma studio",
    "verify:seed": "../node_modules/.bin/ts-node --transpile-only prisma/verify-seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^2.1.5",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  }
}
